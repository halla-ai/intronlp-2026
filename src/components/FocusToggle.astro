---
/**
 * Focus mode toggle — hides the left sidebar and right TOC so only the
 * main content column remains. State persists in localStorage; Escape exits.
 */
---

<starlight-focus-toggle>
  <button
    type="button"
    class="focus-toggle"
    aria-label="집중 모드 전환 (사이드바 숨기기)"
    aria-pressed="false"
    title="집중 모드"
  >
    <svg class="icon icon-enter" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 3H5a2 2 0 0 0-2 2v3"/>
      <path d="M16 3h3a2 2 0 0 1 2 2v3"/>
      <path d="M8 21H5a2 2 0 0 1-2-2v-3"/>
      <path d="M16 21h3a2 2 0 0 0 2-2v-3"/>
    </svg>
    <svg class="icon icon-exit" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 8V5a2 2 0 0 1 2-2h3"/>
      <path d="M21 8V5a2 2 0 0 0-2-2h-3"/>
      <path d="M3 16v3a2 2 0 0 0 2 2h3"/>
      <path d="M21 16v3a2 2 0 0 1-2 2h-3"/>
    </svg>
  </button>
</starlight-focus-toggle>

{/* Inlined to apply the persisted state before paint (no sidebar flash). */}
<script is:inline>
  if (typeof localStorage !== 'undefined' && localStorage.getItem('starlight-focus') === '1') {
    document.documentElement.classList.add('focus-mode');
  }
</script>

<script>
  const storageKey = 'starlight-focus';

  function applyFocus(on: boolean): void {
    document.documentElement.classList.toggle('focus-mode', on);
    document.querySelectorAll('starlight-focus-toggle button').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(on));
    });
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, on ? '1' : '0');
    }
  }

  class StarlightFocusToggle extends HTMLElement {
    constructor() {
      super();
      const on = document.documentElement.classList.contains('focus-mode');
      this.querySelector('button')?.setAttribute('aria-pressed', String(on));
      this.querySelector('button')?.addEventListener('click', () => {
        applyFocus(!document.documentElement.classList.contains('focus-mode'));
      });
    }
  }
  customElements.define('starlight-focus-toggle', StarlightFocusToggle);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.documentElement.classList.contains('focus-mode')) {
      applyFocus(false);
    }
  });
</script>

<style>
  .focus-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .focus-toggle:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
    background: rgba(37, 99, 235, 0.08);
  }

  .icon-exit { display: none; }
  [aria-pressed='true'] .icon-enter { display: none; }
  [aria-pressed='true'] .icon-exit { display: block; }
  [aria-pressed='true'] {
    color: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent);
  }

  /* Sidebar is a drawer below 50rem, so the toggle is a no-op there. */
  @media (max-width: 50rem) {
    .focus-toggle { display: none; }
  }
</style>
